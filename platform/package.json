{
  "name": "asme-nu-engineering-hub",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "npm run db:generate && next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "db:generate": "node scripts/generate-client.mjs",
    "db:migrate": "tsx scripts/schema-engine.mts",
    "db:seed": "tsx prisma/seed.ts",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "test": "tsx --test tests/unit.test.ts",
    "test:integration": "tsx tests/integration.ts",
    "db:migrate:native": "prisma migrate deploy",
    "format": "prettier --write app components lib publication scripts tests prisma/seed.ts *.ts *.mjs",
    "test:browser": "tsx tests/browser.ts",
    "build:pages": "node scripts/build-pages.mjs",
    "test:pages": "tsx tests/pages.ts"
  },
  "dependencies": {
    "@fontsource/cairo": "^5.2.6",
    "@fontsource/inter": "^5.2.8",
    "@hookform/resolvers": "^5.2.2",
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "lucide-react": "^0.577.0",
    "motion": "^12.36.0",
    "next": "16.4.5",
    "nodemailer": "^10.3.1",
    "pdf-lib": "^1.17.1",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.71.0",
    "recharts": "^3.7.0",
    "three": "^0.180.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@prisma/driver-adapter-utils": "7.10.1",
    "@prisma/schema-engine-wasm": "8.1.0-1.d1b3f377ca835d73fd50954a5e22128b9ebdd6b8",
    "@tailwindcss/postcss": "^4.2.0",
    "@types/node": "^24.10.0",
    "@types/nodemailer": "^7.0.11",
    "@types/pg": "^8.16.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.180.0",
    "dotenv": "^17.3.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "prettier": "^3.8.3",
    "prisma": "7.10.1",
    "tailwindcss": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11"
  }
}
