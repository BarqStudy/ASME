generator client {
 provider = "prisma-client-js"
}
datasource db {
 provider = "postgresql"
}
enum Role {
 SUPER_ADMIN
 CLUB_PRESIDENT
 COMMITTEE_LEADER
 EVENTS_MANAGER
 CONTENT_MANAGER
 CLUB_MEMBER
 STUDENT
}
enum ApplicationStatus {
 PENDING
 APPROVED
 REJECTED
 NEEDS_INFO
}
enum RegistrationStatus {
 CONFIRMED
 WAITLISTED
 CANCELLED
}
enum Publication {
 DRAFT
 PENDING
 PUBLISHED
 REJECTED
}
enum ProjectStatus {
 IDEA
 IN_PROGRESS
 COMPLETED
}
enum TaskStatus {
 TODO
 IN_PROGRESS
 DONE
}
enum PostKind {
 NEWS
 ANNOUNCEMENT
 CAREER
 REPORT
}
model User {
 id String @id @default(cuid())
 email String @unique
 passwordHash String
 fullName String
 role Role @default(STUDENT)
 verifiedAt DateTime?
 disabledAt DateTime?
 createdAt DateTime @default(now())
 profile Profile?
 sessions Session[]
 tokens VerificationToken[]
 application MembershipApplication?
 member ClubMember?
 committees CommitteeMembership[]
 ledCommittees Committee[]
 tasks Task[]
 notes TaskNote[]
 registrations EventRegistration[]
 checkins AttendanceRecord[]
 issuedCertificates Certificate[]
 projects Project[]
 projectMemberships ProjectMember[]
 teamApplications TeamApplication[]
 submissions CompetitionSubmission[]
 scores CompetitionScore[]
 savedResources SavedResource[]
 notifications Notification[]
 assets MediaAsset[]
 auditLogs AuditLog[]
}
model Profile {
 id String @id @default(cuid())
 userId String @unique
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 universityId String @default("")
 college String @default("")
 major String @default("")
 level String @default("")
 bioAr String @default("")
 bioEn String @default("")
 skills String[] @default([])
 software String[] @default([])
 experience String[] @default([])
 awards String[] @default([])
 linkedin String @default("")
 github String @default("")
 slug String? @unique
 publicEnabled Boolean @default(false)
 publicSkills Boolean @default(false)
 publicProjects Boolean @default(false)
 publicExperience Boolean @default(false)
 updatedAt DateTime @updatedAt
}
model Session {
 id String @id @default(cuid())
 tokenHash String @unique
 userId String
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 expiresAt DateTime
 createdAt DateTime @default(now())
 @@index([userId,expiresAt])
}
model VerificationToken {
 id String @id @default(cuid())
 tokenHash String @unique
 userId String
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 purpose String
 expiresAt DateTime
 createdAt DateTime @default(now())
 @@index([userId,purpose])
}
model RateBucket {
 key String @id
 count Int @default(1)
 resetsAt DateTime
}
model Committee {
 id String @id @default(cuid())
 title Json
 description Json
 leaderId String?
 leader User? @relation(fields:[leaderId],references:[id],onDelete:SetNull)
 members CommitteeMembership[]
 applications MembershipApplication[]
 tasks Task[]
 published Boolean @default(true)
 createdAt DateTime @default(now())
}
model CommitteeMembership {
 id String @id @default(cuid())
 committeeId String
 committee Committee @relation(fields:[committeeId],references:[id],onDelete:Cascade)
 userId String
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 joinedAt DateTime @default(now())
 @@unique([committeeId,userId])
}
model MembershipApplication {
 id String @id @default(cuid())
 userId String @unique
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 committeeId String?
 committee Committee? @relation(fields:[committeeId],references:[id],onDelete:SetNull)
 status ApplicationStatus @default(PENDING)
 payload Json
 reviewNote String @default("")
 reviewedBy String?
 reviewedAt DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([status,createdAt])
}
model ClubMember {
 id String @id @default(cuid())
 userId String @unique
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 active Boolean @default(true)
 joinedAt DateTime @default(now())
}
model Task {
 id String @id @default(cuid())
 committeeId String
 committee Committee @relation(fields:[committeeId],references:[id],onDelete:Cascade)
 assigneeId String?
 assignee User? @relation(fields:[assigneeId],references:[id],onDelete:SetNull)
 title Json
 description Json
 status TaskStatus @default(TODO)
 dueAt DateTime?
 notes TaskNote[]
 attachments TaskAttachment[]
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([committeeId,status,dueAt])
}
model TaskNote {
 id String @id @default(cuid())
 taskId String
 task Task @relation(fields:[taskId],references:[id],onDelete:Cascade)
 authorId String
 author User @relation(fields:[authorId],references:[id],onDelete:Cascade)
 body String
 createdAt DateTime @default(now())
}
model TaskAttachment {
 id String @id @default(cuid())
 taskId String
 task Task @relation(fields:[taskId],references:[id],onDelete:Cascade)
 assetId String
 asset MediaAsset @relation(fields:[assetId],references:[id],onDelete:Cascade)
 @@unique([taskId,assetId])
}
model Event {
 id String @id @default(cuid())
 slug String @unique
 title Json
 description Json
 body Json
 location Json
 category String
 searchText String @default("")
 startsAt DateTime
 endsAt DateTime
 deadline DateTime
 capacity Int
 waitlistEnabled Boolean @default(true)
 published Boolean @default(false)
 featured Boolean @default(false)
 isSample Boolean @default(false)
 coverUrl String @default("")
 registrations EventRegistration[]
 assets MediaAsset[]
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([published,startsAt])
}
model EventRegistration {
 id String @id @default(cuid())
 userId String
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 eventId String
 event Event @relation(fields:[eventId],references:[id],onDelete:Cascade)
 status RegistrationStatus
 qrToken String @unique
 attendance AttendanceRecord?
 certificate Certificate?
 feedback EventFeedback?
 createdAt DateTime @default(now())
 cancelledAt DateTime?
 @@unique([userId,eventId])
 @@index([eventId,status,createdAt])
}
model AttendanceRecord {
 id String @id @default(cuid())
 registrationId String @unique
 registration EventRegistration @relation(fields:[registrationId],references:[id],onDelete:Cascade)
 checkedById String
 checkedBy User @relation(fields:[checkedById],references:[id])
 checkedAt DateTime @default(now())
}
model EventFeedback {
 id String @id @default(cuid())
 registrationId String @unique
 registration EventRegistration @relation(fields:[registrationId],references:[id],onDelete:Cascade)
 rating Int
 comment String @default("")
 createdAt DateTime @default(now())
}
model Certificate {
 id String @id @default(cuid())
 code String @unique
 registrationId String @unique
 registration EventRegistration @relation(fields:[registrationId],references:[id])
 issuedById String
 issuedBy User @relation(fields:[issuedById],references:[id])
 snapshot Json
 issuedAt DateTime @default(now())
 revokedAt DateTime?
}
model Course {
 id String @id @default(cuid())
 slug String @unique
 title Json
 description Json
 resources Resource[]
}
model Resource {
 id String @id @default(cuid())
 courseId String
 course Course @relation(fields:[courseId],references:[id])
 title Json
 description Json
 type String
 externalUrl String @default("")
 assetId String?
 asset MediaAsset? @relation(fields:[assetId],references:[id],onDelete:SetNull)
 author String @default("")
 license String
 rightsConfirmed Boolean
 searchText String @default("")
 published Boolean @default(false)
 featured Boolean @default(false)
 saves SavedResource[]
 createdAt DateTime @default(now())
 @@index([courseId,published])
}
model SavedResource {
 id String @id @default(cuid())
 userId String
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 resourceId String
 resource Resource @relation(fields:[resourceId],references:[id],onDelete:Cascade)
 createdAt DateTime @default(now())
 @@unique([userId,resourceId])
}
model Project {
 id String @id @default(cuid())
 ownerId String
 owner User @relation(fields:[ownerId],references:[id])
 title Json
 description Json
 body Json
 category String
 technologies String[]
 skillsNeeded String[]
 needsTeam Boolean @default(false)
 status ProjectStatus @default(IDEA)
 publication Publication @default(PENDING)
 featured Boolean @default(false)
 isSample Boolean @default(false)
 coverUrl String @default("")
 videoUrl String @default("")
 cadAssetId String?
 searchText String @default("")
 members ProjectMember[]
 applications TeamApplication[]
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([publication,category,needsTeam])
}
model ProjectMember {
 id String @id @default(cuid())
 projectId String
 project Project @relation(fields:[projectId],references:[id],onDelete:Cascade)
 userId String
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 joinedAt DateTime @default(now())
 @@unique([projectId,userId])
}
model TeamApplication {
 id String @id @default(cuid())
 projectId String
 project Project @relation(fields:[projectId],references:[id],onDelete:Cascade)
 userId String
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 message String
 status ApplicationStatus @default(PENDING)
 createdAt DateTime @default(now())
 @@unique([projectId,userId])
}
model Competition {
 id String @id @default(cuid())
 title Json
 description Json
 rules Json
 criteria Json
 deadline DateTime
 published Boolean @default(false)
 resultsPublished Boolean @default(false)
 isSample Boolean @default(false)
 submissions CompetitionSubmission[]
 createdAt DateTime @default(now())
 @@index([published,deadline])
}
model CompetitionSubmission {
 id String @id @default(cuid())
 competitionId String
 competition Competition @relation(fields:[competitionId],references:[id],onDelete:Cascade)
 userId String
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 title String
 description String
 link String @default("")
 assetId String?
 publicName Boolean @default(false)
 scores CompetitionScore[]
 createdAt DateTime @default(now())
 @@unique([competitionId,userId])
}
model CompetitionScore {
 id String @id @default(cuid())
 submissionId String
 submission CompetitionSubmission @relation(fields:[submissionId],references:[id],onDelete:Cascade)
 judgeId String
 judge User @relation(fields:[judgeId],references:[id])
 criteria Json
 total Int
 feedback String @default("")
 @@unique([submissionId,judgeId])
}
model Post {
 id String @id @default(cuid())
 kind PostKind
 title Json
 description Json
 body Json
 coverUrl String @default("")
 externalUrl String @default("")
 published Boolean @default(false)
 featured Boolean @default(false)
 isSample Boolean @default(false)
 searchText String @default("")
 createdAt DateTime @default(now())
 @@index([kind,published,createdAt])
}
model MediaAsset {
 id String @id @default(cuid())
 ownerId String
 owner User @relation(fields:[ownerId],references:[id])
 originalName String
 storageName String @unique
 mime String
 size Int
 public Boolean @default(false)
 license String @default("")
 eventId String?
 event Event? @relation(fields:[eventId],references:[id],onDelete:SetNull)
 resources Resource[]
 taskAttachments TaskAttachment[]
 createdAt DateTime @default(now())
}
model Notification {
 id String @id @default(cuid())
 userId String
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 title Json
 body Json
 link String
 readAt DateTime?
 createdAt DateTime @default(now())
 @@index([userId,readAt,createdAt])
}
model ContactMessage {
 id String @id @default(cuid())
 name String
 email String
 kind String
 subject String
 message String
 resolvedAt DateTime?
 createdAt DateTime @default(now())
 @@index([resolvedAt,createdAt])
}
model AuditLog {
 id String @id @default(cuid())
 actorId String?
 actor User? @relation(fields:[actorId],references:[id],onDelete:SetNull)
 action String
 entityType String
 entityId String
 detail Json
 createdAt DateTime @default(now())
 @@index([entityType,createdAt])
}
model PlatformSetting {
 key String @id
 value Json
 updatedAt DateTime @updatedAt
}
